<?xml version="1.0"?>
<ruleset name="Dash Dolphin WordPress Coding Standards">
    <description>WordPress coding standards for the Dash Dolphin plugin.</description>

    <!-- Scope to the plugin directory -->
    <file>dash-dolphin/</file>

    <!-- Exclude test directory -->
    <exclude-pattern>dash-dolphin/tests/*</exclude-pattern>

    <!-- Exclude vendor directory -->
    <exclude-pattern>vendor/*</exclude-pattern>

    <!-- Use WordPress coding standards -->
    <rule ref="WordPress">
        <!-- Set the minimum supported WP version -->
        <properties>
            <property name="minimum_supported_version" value="6.0"/>
        </properties>
    </rule>

    <!-- Verify that text domain is correct -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array" value="dash-dolphin"/>
        </properties>
    </rule>

    <!-- Set PHP version compatibility -->
    <config name="testVersion" value="7.4-"/>

    <!-- Show progress and use colors -->
    <arg value="sp"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
</ruleset>
